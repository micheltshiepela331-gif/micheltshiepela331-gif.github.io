<style>
/* LushiPratique — site en plusieurs interfaces : Accueil, Applications, Annonces, Contact.
   Chaque application a sa couleur et sa fiche, qui s'ouvre par-dessus et se ferme avec ✕. */
:root{
 color-scheme:light;
 --bg:#FFFFFF; --soft:#F4F6FC; --ink:#0D1B3A; --muted:#55627A; --line:#E3E8F1;
 --navy:#0B3478; --orange:#F7871A; --orange-ink:#A85400; --violet:#5B34E0; --pink:#E2187B; --gold:#D4AF5A; --night:#0D1638;
 --shop:#0E9F6E; --tresor:#B8861E; --kalamu:#5B34E0; --djambo:#1A9BE0; --likelemba:#F08A00; --carnet:#E2187B; --kiosque:#0F9AA8;
 --display:"Nunito","Trebuchet MS",system-ui,sans-serif;
 --body:"Source Sans 3",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
 --serif:"Cormorant Garamond",Georgia,"Times New Roman",serif;
 --top:calc(64px + env(safe-area-inset-top,0px)); --bot:calc(66px + env(safe-area-inset-bottom,0px));
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:calc(var(--top) + 12px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17.5px;line-height:1.6;-webkit-tap-highlight-color:transparent}
body.locked{overflow:hidden}
img{display:block;max-width:100%;height:auto}
[hidden]{display:none!important}
h1,h2,h3,h4{font-family:var(--display);color:inherit;line-height:1.12;margin:0;text-wrap:balance}
p{margin:0}
a{color:inherit}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--orange);outline-offset:3px;border-radius:8px}
.in{max-width:1180px;margin:0 auto;padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
.eyebrow{font-family:var(--display);font-weight:800;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-ink)}
.lead{font-size:1.15rem;color:var(--muted);max-width:62ch}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:12px;padding:13px 20px;font-family:var(--display);font-weight:800;font-size:1rem;text-decoration:none;border:2px solid transparent;text-align:center;max-width:100%;cursor:pointer;background:none}
.btn.orange{background:var(--orange);color:#1A0E00}
.btn.navy{background:var(--navy);color:#fff}
.btn.white{background:#fff;color:var(--navy)}
.btn.line{border-color:var(--line);color:var(--ink);background:#fff}
.btn.ghost{border-color:rgba(255,255,255,.45);color:#fff}
.btn.c{background:var(--c);color:#fff}
.btn.cl{border-color:color-mix(in srgb,var(--c) 45%,#fff);color:var(--c);background:#fff}
.ctas{display:flex;flex-wrap:wrap;gap:10px}
.tag{display:inline-block;font-family:var(--display);font-weight:800;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:4px 11px}
.tag.ok{background:#E3F6EE;color:#0B6E4C}
.tag.new{background:#EDE7FF;color:#4325B8}
.tag.soon{background:#FFF0DD;color:#9A5300}
.tag.free{background:#F7EFD9;color:#7A5A10}

/* ---------- En-tête ---------- */
.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:saturate(1.2) blur(8px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
.top .in{display:flex;align-items:center;gap:18px;height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--display);font-weight:900;font-size:1.3rem}
.brand img{width:38px;height:38px;border-radius:10px}
.brand .l{color:var(--navy)}.brand .p{color:var(--orange)}
.tabs{display:flex;gap:6px;margin-left:auto}
.tabs a{display:flex;align-items:center;gap:7px;text-decoration:none;font-family:var(--display);font-weight:800;font-size:.98rem;color:var(--muted);padding:9px 14px;border-radius:12px}
.tabs a:hover{background:var(--soft);color:var(--ink)}
.tabs a.on{background:var(--tc);color:#fff}
.tabs svg,.bnav svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;flex:none}
.bnav{display:none}

/* ---------- Interfaces ---------- */
.view{display:none;animation:vin .28s ease}
.view.on{display:block}
@keyframes vin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
section{padding-block:64px}
.head{display:grid;gap:10px;margin-bottom:34px;max-width:760px}
.head h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900}
.soft{background:var(--soft)}
.vhero{color:#fff;padding-block:46px 52px;background:var(--vg)}
.vhero h1{font-size:clamp(2rem,4.6vw,3.2rem);font-weight:900;margin:10px 0 12px}
.vhero .eyebrow{color:rgba(255,255,255,.85)}
.vhero .lead{color:rgba(255,255,255,.9)}

/* Accueil */
.hero{background:linear-gradient(130deg,#0B3478 0%,#3A2BC0 48%,#B0207C 100%);color:#fff;overflow:hidden}
.hero .in{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center;padding-block:56px 64px}
.hero h1{font-size:clamp(2.2rem,5vw,3.7rem);font-weight:900;letter-spacing:-.02em;margin:12px 0 16px}
.hero h1 em{font-style:normal;color:#FFC36B}
.hero .eyebrow{color:#FFC36B}
.hero .lead{color:rgba(255,255,255,.9);margin-bottom:26px}
.trust{display:flex;flex-wrap:wrap;gap:8px 18px;margin:26px 0 0;list-style:none;padding:0;font-size:.95rem;font-weight:600;color:rgba(255,255,255,.92)}
.trust li{display:flex;align-items:center;gap:7px}
.trust svg{width:18px;height:18px;fill:none;stroke:#7CF0B8;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.phones{position:relative;height:520px}
.phone{position:absolute;width:min(250px,42vw);border-radius:32px;padding:8px;background:#0D1B3A;box-shadow:0 30px 60px rgba(0,0,0,.35)}
.phone img{border-radius:25px;width:100%}
.phone.a{left:4%;top:0;transform:rotate(-5deg)}
.phone.b{right:2%;top:60px;transform:rotate(5deg)}
.land{position:absolute;left:8%;right:0;bottom:0;border-radius:18px;padding:7px;background:#0D1B3A;box-shadow:0 24px 50px rgba(0,0,0,.4);transform:rotate(-2deg)}
.land img{border-radius:12px}
.quick{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:14px}
.qa{display:flex;flex-direction:column;align-items:flex-start;gap:10px;text-decoration:none;border-radius:20px;padding:18px;background:#fff;border:1px solid var(--line);box-shadow:0 6px 18px rgba(13,27,58,.06);transition:transform .15s}
.qa:hover{transform:translateY(-3px)}
.qa .ico{width:50px;height:50px;border-radius:15px;display:grid;place-items:center;background:var(--c);color:#fff;font-family:var(--display);font-weight:900;font-size:1.15rem;box-shadow:0 8px 18px color-mix(in srgb,var(--c) 35%,transparent)}
.qa .ico img{width:100%;height:100%;border-radius:15px}
.qa b{font-family:var(--display);font-size:1.05rem;line-height:1.2}
.qa small{color:var(--muted);font-size:.85rem;line-height:1.3}
.why{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.why div{border-radius:20px;padding:22px;background:#fff;border-top:5px solid var(--c);box-shadow:0 6px 18px rgba(13,27,58,.06);display:grid;gap:8px;align-content:start}
.why .k{font-family:var(--display);font-weight:800;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--c)}
.why b{font-family:var(--display);font-size:1.2rem}
.why p{color:var(--muted)}
.about{display:grid;grid-template-columns:.75fr 1.25fr;gap:48px;align-items:center}
.about .logo{border-radius:28px;overflow:hidden;border:1px solid var(--line);max-width:400px}
.about p{color:var(--muted);margin-top:12px}
.values{display:grid;gap:12px;margin-top:22px}
.values div{border-left:4px solid var(--c);padding-left:14px}
.values b{font-family:var(--display);display:block}
.fondateur{display:flex;align-items:center;gap:16px;margin-top:22px;padding:14px;border:1px solid var(--line);border-radius:20px;background:#fff}
.fondateur img{width:80px;height:80px;flex:none;border-radius:50%;object-fit:cover;object-position:50% 30%}
.fondateur b{display:block;font-family:var(--display);font-size:1.12rem}
.fondateur span{color:var(--muted);font-size:.95rem}

/* Applications */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
.chip{border:2px solid var(--line);background:#fff;border-radius:999px;padding:8px 16px;font-family:var(--display);font-weight:800;font-size:.95rem;color:var(--muted);cursor:pointer}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
.apps{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:22px}
.app{text-decoration:none;border-radius:24px;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:0 8px 24px rgba(13,27,58,.07);display:flex;flex-direction:column;cursor:pointer;transition:transform .15s,box-shadow .15s;text-align:left;padding:0;font:inherit;color:inherit}
.app:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(13,27,58,.12)}
.app .pic{aspect-ratio:16/10;overflow:hidden;background:linear-gradient(135deg,var(--c),color-mix(in srgb,var(--c) 55%,#0D1B3A));position:relative;display:grid;place-items:center}
.app .pic img{width:100%;height:100%;object-fit:cover}
.app .pic .big{font-family:var(--display);font-weight:900;font-size:3.4rem;color:#fff;opacity:.95}
.app .pic .em{font-size:4rem}
.app .bar{height:6px;background:var(--c)}
.app .body{padding:20px 22px 22px;display:grid;gap:10px;align-content:start;flex:1}
.app h3{font-size:1.45rem}
.app .tag,.post .tag{justify-self:start}
.app p{color:var(--muted);font-size:1rem}
.app .go{margin-top:auto;font-family:var(--display);font-weight:800;color:var(--c);display:flex;align-items:center;gap:6px}
.safe{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.safe div{border:1px solid var(--line);border-radius:18px;padding:20px;background:#fff}
.safe b{font-family:var(--display);display:block;font-size:1.08rem;margin-bottom:4px}
.safe p{color:var(--muted);font-size:.98rem}
.safe .alert{border-color:#E9B48A;background:#FFF6EE}
.safe .alert b{color:var(--orange-ink)}

/* Annonces */
.feed{display:grid;gap:18px;max-width:880px}
.post{border-radius:22px;background:#fff;border:1px solid var(--line);overflow:hidden;box-shadow:0 6px 18px rgba(13,27,58,.06);display:grid;grid-template-columns:8px 1fr}
.post::before{content:"";background:var(--c)}
.post .pb{padding:20px 22px;display:grid;gap:8px}
.post .meta{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:var(--muted);font-size:.9rem}
.post h3{font-size:1.3rem}
.post p{color:var(--muted)}
.post ul{margin:4px 0 0;padding-left:20px;color:var(--ink)}
.post li{margin:4px 0}
.posters{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:start}
.posters figure{margin:0;border-radius:20px;overflow:hidden;border:1px solid var(--line);background:var(--soft)}
.posters figcaption{padding:11px 15px;font-size:.95rem;color:var(--muted);background:#fff;border-top:1px solid var(--line)}
.soon{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.soon button{all:unset;cursor:pointer;border-radius:20px;padding:20px;color:#fff;background:linear-gradient(140deg,var(--c),color-mix(in srgb,var(--c) 55%,#0D1B3A));display:grid;gap:6px;box-shadow:0 10px 24px color-mix(in srgb,var(--c) 30%,transparent)}
.soon button:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
.soon .em{font-size:2rem}
.soon b{font-family:var(--display);font-size:1.25rem}
.soon small{opacity:.9;font-size:.95rem;line-height:1.35}
.pub{border-radius:26px;padding:34px;background:linear-gradient(120deg,#F7871A,#E2187B);color:#fff;display:grid;grid-template-columns:1.3fr .7fr;gap:24px;align-items:center}
.pub h2{font-size:clamp(1.6rem,3.6vw,2.3rem)}
.pub p{opacity:.95;margin-top:10px}

/* Contact */
.contact{background:var(--navy);color:#fff;border-radius:28px;padding:34px;display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center}
.contact h2{font-size:clamp(1.7rem,3.6vw,2.4rem)}
.contact p{opacity:.88;margin-top:10px}
.ct{display:grid;gap:12px}
.ct div{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:14px;padding:13px 15px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.ct small{display:block;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase;opacity:.7}
.ct span{font-weight:700;user-select:all;-webkit-user-select:all;overflow-wrap:anywhere}
.ct button{border:none;border-radius:10px;background:#fff;color:var(--navy);font:inherit;font-size:.88rem;font-weight:700;padding:8px 12px;cursor:pointer;flex:none}
.faq{display:grid;gap:10px;max-width:900px}
details{border:1px solid var(--line);border-radius:16px;background:#fff;padding:0 20px}
summary{cursor:pointer;list-style:none;font-family:var(--display);font-weight:800;font-size:1.06rem;padding:16px 0;display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--orange-ink);font-size:1.4rem;line-height:1}
details[open] summary::after{content:"–"}
details p{color:var(--muted);padding-bottom:16px}
.privacy{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.box{border:1px solid var(--line);border-radius:20px;padding:22px;background:#fff}
.box h3{font-size:1.15rem;margin-bottom:8px}
.box p{color:var(--muted);font-size:1rem}
.box p+p{margin-top:8px}
.maj{margin-top:18px;color:var(--muted);font-size:.95rem}
footer{padding-block:26px 30px;color:var(--muted);font-size:.92rem;border-top:1px solid var(--line)}
footer .in{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}
footer a{color:var(--muted)}

/* ---------- Fiches d'application (par-dessus, avec ✕) ---------- */
.sheet{position:fixed;inset:0;z-index:40;background:#fff;overflow:auto;overscroll-behavior:contain;display:none;animation:sin .25s ease}
.sheet.on{display:block}
@keyframes sin{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.sh-top{position:sticky;top:0;z-index:2;background:var(--c);color:#fff;padding-top:env(safe-area-inset-top,0px);box-shadow:0 2px 12px rgba(0,0,0,.15)}
.sh-top .in{display:flex;align-items:center;gap:12px;height:60px}
.sh-top .ico{width:38px;height:38px;border-radius:11px;background:rgba(255,255,255,.2);display:grid;place-items:center;font-family:var(--display);font-weight:900;overflow:hidden;flex:none}
.sh-top .ico img{width:100%;height:100%}
.sh-top b{font-family:var(--display);font-size:1.2rem;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.x{border:0;background:rgba(255,255,255,.18);color:#fff;width:44px;height:44px;border-radius:12px;font-size:22px;line-height:1;cursor:pointer;flex:none}
.x:hover,.x:active{background:#E0242E}
.sh-hero{background:linear-gradient(140deg,var(--c),color-mix(in srgb,var(--c) 50%,#0D1B3A));color:#fff;padding-block:40px 46px}
.sh-hero .in{display:grid;grid-template-columns:1.1fr .9fr;gap:36px;align-items:center}
.sh-hero h2{font-size:clamp(1.9rem,4.4vw,3rem);font-weight:900;margin:10px 0 12px}
.sh-hero .lead{color:rgba(255,255,255,.92)}
.sh-hero .eyebrow{color:rgba(255,255,255,.85)}
.sh-hero .shotbox{display:flex;justify-content:center}
.sh-hero .phone{position:static;transform:none;width:min(250px,62vw)}
.sh-hero .landbox{border-radius:16px;padding:7px;background:#0D1B3A;box-shadow:0 24px 50px rgba(0,0,0,.35)}
.sh-hero .landbox img{border-radius:10px}
.feat{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding-block:34px;border-top:1px solid var(--line)}
.feat:first-of-type{border-top:none}
.feat.rev .shot{order:2}
.shot{display:flex;justify-content:center;background:var(--soft);border-radius:28px;padding:32px 22px}
.shot .phone{position:static;transform:none;width:min(260px,66vw)}
.feat h3{font-size:clamp(1.4rem,3vw,1.9rem);margin:8px 0 12px}
.feat p{color:var(--muted);margin-bottom:10px;max-width:56ch}
.feat ul{margin:12px 0 0;padding-left:20px}
.feat li{margin:5px 0}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.mini{border:1px solid var(--line);border-radius:18px;padding:20px;background:#fff;display:grid;gap:6px;align-content:start}
.mini h4{font-size:1.1rem}
.mini p{color:var(--muted);font-size:.98rem}
.mini .tag{justify-self:start}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;list-style:none;margin:0;padding:0;counter-reset:s}
.steps li{counter-increment:s;border-top:4px solid var(--c);padding-top:16px}
.steps li::before{content:"Étape " counter(s);display:block;font-family:var(--display);font-weight:800;color:var(--c);font-size:.84rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px}
.steps b{display:block;font-family:var(--display);font-size:1.12rem;margin-bottom:4px}
.steps span{color:var(--muted);font-size:1rem}
.price{display:grid;grid-template-columns:1.2fr .8fr;gap:26px;align-items:center;background:var(--c);color:#fff;border-radius:28px;padding:36px}
.price h3{font-size:clamp(1.4rem,3vw,2rem)}
.price p{opacity:.92;margin-top:10px}
.price .bigt{font-family:var(--display);font-weight:900;font-size:clamp(2.4rem,6vw,3.6rem);line-height:1}
.price .side{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:22px;display:grid;gap:10px}
.dl{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:start}
.dl>*,.price>*{min-width:0}
.dl-main{border:2px solid var(--c);border-radius:24px;padding:26px;background:#fff;display:grid;gap:14px}
.dl-main h3{font-size:1.5rem}
.dl-main .tag{justify-self:start}
.addr{display:flex;align-items:center;gap:10px;background:#E3F6EE;color:#0B6E4C;border-radius:12px;padding:11px 13px;font-weight:700;overflow-wrap:anywhere;min-width:0}
.addr svg{flex:none;width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.facts{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:1rem;margin:0}
.facts dt{color:var(--muted)}.facts dd{margin:0;font-weight:600;min-width:0;overflow-wrap:anywhere}
.guard{display:grid;gap:12px}
.guard div{border:1px solid var(--line);border-radius:18px;padding:18px;background:#fff}
.guard b{font-family:var(--display);display:block;font-size:1.06rem;margin-bottom:4px}
.guard p{color:var(--muted);font-size:.98rem}
.guard .alert{border-color:#E9B48A;background:#FFF6EE}
.guard .alert b{color:var(--orange-ink)}
.ver{display:inline-flex;align-items:center;gap:10px;font-family:var(--display);font-weight:800;color:var(--c)}
.ver b{background:var(--c);color:#fff;border-radius:8px;padding:2px 10px}
.avis{display:grid;grid-template-columns:1.3fr .7fr;gap:24px;align-items:center;border:1px solid var(--line);border-radius:24px;padding:28px;background:#fff}
.avis p{color:var(--muted);margin-top:8px}
.tresor-sh .sh-hero{background:var(--night) url("data:image/webp;base64,") center/cover no-repeat;position:relative}
.tresor-sh .sh-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,22,56,.55),rgba(13,22,56,.88))}
.tresor-sh .sh-hero .in{position:relative;z-index:1}
.tresor-sh .sh-hero h2{font-family:var(--serif);color:#F3DFA8;font-weight:700}
.tr-quote{font-family:var(--serif);font-size:1.5rem;font-style:italic;margin:4px 0 16px}
.checks{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:9px}
.checks li{display:flex;gap:11px;align-items:flex-start}
.checks svg{flex:none;width:22px;height:22px;margin-top:3px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;color:var(--gold)}
.light .checks svg{color:var(--c)}
.tr-photo{border-radius:20px;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.4);border:1px solid rgba(212,175,90,.35)}
.notice{border-radius:18px;padding:18px 20px;background:color-mix(in srgb,var(--c) 10%,#fff);border-left:5px solid var(--c);color:var(--ink)}

@media (max-width:980px){
 .tabs{display:none}
 body{padding-bottom:var(--bot)}
 .bnav{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;left:0;right:0;bottom:0;z-index:30;background:#fff;border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));box-shadow:0 -6px 20px rgba(13,27,58,.08)}
 .bnav a{display:flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;font-family:var(--display);font-weight:800;font-size:.74rem;color:var(--muted);padding:6px 2px;border-radius:12px}
 .bnav a.on{color:#fff;background:var(--tc)}
 .hero .in,.about,.contact,.pub,.price,.dl,.avis,.feat,.sh-hero .in{grid-template-columns:1fr}
 .feat.rev .shot{order:0}
 .why,.safe,.privacy{grid-template-columns:1fr}
 .grid3,.posters,.steps{grid-template-columns:1fr 1fr}
 .phones{height:440px}
 section{padding-block:48px}
}
@media (max-width:560px){
 body{font-size:16.5px}
 .grid3,.posters,.steps{grid-template-columns:1fr}
 .phones{height:380px}.phone{width:190px}.phone.a{left:0}.phone.b{right:0;top:40px}
 .land{left:0}
 .quick{grid-template-columns:1fr 1fr}
 .contact,.pub,.price{padding:24px}
 .brand{font-size:1.15rem}
}
@media (prefers-reduced-motion:reduce){.view,.sheet{animation:none}.qa,.app{transition:none}}
</style>
</head>
<body>
<header class="top">
 <div class="in">
  <a class="brand" href="#accueil"><img src="data:image/png;base64," alt=""><span><span class="l">Lushi</span><span class="p">Pratique</span></span></a>
  <nav class="tabs" aria-label="Menu principal">
   <a href="#accueil" data-v="accueil" style="--tc:#0B3478"><svg viewBox="0 0 24 24"><path d="M3.5 11 12 4l8.5 7"/><path d="M6 9.5V20h12V9.5"/></svg>Accueil</a>
   <a href="#applications" data-v="applications" style="--tc:#5B34E0"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"/></svg>Applications</a>
   <a href="#annonces" data-v="annonces" style="--tc:#E2187B"><svg viewBox="0 0 24 24"><path d="M4 10v4h3l7 4V6L7 10z"/><path d="M17.5 9.5a3.5 3.5 0 0 1 0 5"/></svg>Annonces</a>
   <a href="#contact" data-v="contact" style="--tc:#F08A00"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>Contact</a>
  </nav>
 </div>
</header>

<main>
<!-- ===================== INTERFACE 1 : ACCUEIL ===================== -->
<div class="view" id="v-accueil" data-view="accueil">
 <div class="hero">
  <div class="in">
   <div>
    <p class="eyebrow">Lubumbashi · applications mobiles</p>
    <h1>LushiPratique : la technologie <em>au service de la cité</em>.</h1>
    <p class="lead">LushiPratique crée des applications mobiles pratiques pour répondre aux besoins réels de la population de Lubumbashi : tenir sa caisse, apprendre, écrire ses travaux, transmettre. Des idées simples, des solutions utiles.</p>
    <div class="ctas">
     <a class="btn orange" href="#applications">Voir nos applications</a>
     <a class="btn ghost" href="#annonces">Les nouveautés</a>
    </div>
    <ul class="trust">
     <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Fonctionne sans Internet</li>
     <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Vos données restent dans votre téléphone</li>
     <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>En français</li>
     <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Un vrai contact à Lubumbashi</li>
    </ul>
   </div>
   <div class="phones" aria-label="Captures de Shop Rédemption et de Kalamu">
    <div class="phone a"><img data-id="jour.jpg" src="data:image/webp;base64," width="440" height="952" decoding="async" alt="Shop Rédemption : écran Journée avec le gain du jour (chiffres d'exemple)"></div>
    <div class="phone b"><img data-id="change.jpg" src="data:image/webp;base64," width="440" height="952" decoding="async" alt="Shop Rédemption : écran Change"></div>
    <div class="land"><img data-id="kalamu.jpg" src="data:image/webp;base64," width="960" height="456" decoding="async" alt="Kalamu : un travail pratique ouvert, avec les onglets comme dans Word"></div>
   </div>
  </div>
 </div>

 <section>
  <div class="in">
   <div class="head"><p class="eyebrow">Nos applications</p><h2>Choisissez votre application</h2><p class="lead">Touchez une application pour tout savoir et la télécharger.</p></div>
   <div class="quick">
    <a class="qa" href="#app-shop" style="--c:var(--shop)"><span class="ico">SR</span><b>Shop Rédemption</b><small>Caisse des shops d'unités et de change</small></a>
    <a class="qa" href="#app-tresor" style="--c:var(--tresor)"><span class="ico"><img data-id="td-icone.png" src="data:image/webp;base64," alt=""></span><b>Trésor des dates</b><small>Encyclopédie du temps biblique</small></a>
    <a class="qa" href="#app-kalamu" style="--c:var(--kalamu)"><span class="ico">K</span><b>Kalamu</b><small>Traitement de texte des étudiants</small></a>
    <a class="qa" href="#annonces/prochainement" style="--c:var(--likelemba)"><span class="ico">+4</span><b>Bientôt</b><small>Djambo, Likelemba, Mon carnet, Inventaire</small></a>
   </div>
  </div>
 </section>

 <section id="objectif" class="soft">
  <div class="in">
   <div class="head"><p class="eyebrow">Notre objectif</p><h2>Ce que fait LushiPratique, en clair</h2><p class="lead">Nous partons d'un vrai problème vécu à Lubumbashi, et nous le réglons avec une application simple, sur le téléphone que vous avez déjà.</p></div>
   <div class="why">
    <div style="--c:#E0242E"><span class="k">Le problème</span><b>Des besoins de tous les jours, sans outil adapté</b><p>Le commerçant qui ne connaît pas son vrai gain le soir. L'étudiant qui doit rendre un travail tapé sans ordinateur. Le croyant qui veut situer les événements de la Bible.</p></div>
    <div style="--c:var(--violet)"><span class="k">Notre réponse</span><b>Une application pour chaque besoin</b><p>Shop Rédemption pour la caisse, Kalamu pour les travaux d'étudiants, Trésor des dates pour l'histoire biblique. D'autres suivent.</p></div>
    <div style="--c:var(--shop)"><span class="k">Notre engagement</span><b>Simple, privé, au prix de la cité</b><p>En français, sans Internet une fois installée, sans publicité dans les applications. Vos données restent dans votre téléphone.</p></div>
   </div>
  </div>
 </section>

 <section id="apropos">
  <div class="in about">
   <div class="logo"><img data-id="logo.jpg" src="data:image/webp;base64," width="420" height="420" decoding="async" alt="Logo LushiPratique : un téléphone avec une coche, au-dessus de Lubumbashi et de son chevalement minier"></div>
   <div>
    <p class="eyebrow">À propos</p>
    <h2 style="font-size:clamp(1.8rem,4vw,2.5rem);margin-top:8px">Bienvenue chez LushiPratique</h2>
    <p>Nous créons des applications mobiles pratiques pour répondre aux besoins réels de la population de Lubumbashi.</p>
    <p>Notre vision : transformer les petits problèmes du quotidien en solutions numériques simples, utiles et accessibles à tous.</p>
    <div class="values">
     <div style="--c:var(--orange)"><b>Des applications pratiques.</b> Faites pour le téléphone que vous avez déjà.</div>
     <div style="--c:var(--violet)"><b>Des idées locales.</b> Nées dans les shops, les universités et les rues de Lubumbashi.</div>
     <div style="--c:var(--shop)"><b>Des solutions pour notre communauté.</b> Simples à apprendre, en français, au prix de la cité.</div>
    </div>
    <div class="fondateur"><img src="data:image/jpeg;base64," width="80" height="80" loading="lazy" alt="Michel Tshiepela, fondateur de LushiPratique"><div><b>Michel Tshiepela</b><span>Fondateur et concepteur de LushiPratique, Lubumbashi</span></div></div>
   </div>
  </div>
 </section>
</div>

<!-- ===================== INTERFACE 2 : APPLICATIONS ===================== -->
<div class="view" id="v-applications" data-view="applications">
 <div class="vhero" style="--vg:linear-gradient(130deg,#3A2BC0,#5B34E0 50%,#1A9BE0)">
  <div class="in"><p class="eyebrow">Applications</p><h1>Toutes nos applications</h1><p class="lead">Chacune a sa couleur et sa fiche. Touchez une application pour l'ouvrir, la fiche se ferme avec ✕.</p></div>
 </div>
 <section>
  <div class="in">
   <div class="chips" role="group" aria-label="Filtrer">
    <button class="chip on" data-f="all">Toutes</button><button class="chip" data-f="dispo">Disponibles</button><button class="chip" data-f="bientot">Bientôt</button>
   </div>
   <div class="apps">
    <a class="app" href="#app-shop" data-k="dispo" style="--c:var(--shop)"><div class="pic"><img data-meme="shop-affiche.jpg" alt="Affiche Shop Rédemption" style="object-position:center top"></div><div class="bar"></div><div class="body"><span class="tag ok">Disponible · Android et en ligne</span><h3>Shop Rédemption</h3><p>Le journal de caisse des shops d'unités, de Mobile Money et de change : gain du jour, dollars en stock, argent qui manque.</p><span class="go">Ouvrir la fiche →</span></div></a>
    <a class="app" href="#app-tresor" data-k="dispo" style="--c:var(--tresor)"><div class="pic"><img data-meme="tresor-photo.jpg" alt="Trésor des dates sur une tablette, près d'une Bible"></div><div class="bar"></div><div class="body"><span class="tag free">Gratuit · Android et en ligne</span><h3>Trésor des dates</h3><p>L'encyclopédie du temps biblique : toute l'histoire de la Bible sur une seule ligne du temps, de la Création à aujourd'hui.</p><span class="go">Ouvrir la fiche →</span></div></a>
    <a class="app" href="#app-kalamu" data-k="dispo" style="--c:var(--kalamu)"><div class="pic"><img data-meme="kalamu.jpg" alt="Kalamu sur un téléphone à l'horizontale"></div><div class="bar"></div><div class="body"><span class="tag new">Nouveau · en ligne</span><h3>Kalamu</h3><p>Le traitement de texte des étudiants : les onglets de Word sur votre téléphone, avec page de garde, tableaux, table des matières, Word et PDF.</p><span class="go">Ouvrir la fiche →</span></div></a>
    <a class="app" href="#app-djambo" data-k="bientot" style="--c:var(--djambo)"><div class="pic"><span class="em">💬</span></div><div class="bar"></div><div class="body"><span class="tag soon">En préparation</span><h3>Djambo</h3><p>Une messagerie gratuite pour tout le monde, pensée pour consommer le moins de données possible.</p><span class="go">En savoir plus →</span></div></a>
    <a class="app" href="#app-likelemba" data-k="bientot" style="--c:var(--likelemba)"><div class="pic"><span class="em">🤝</span></div><div class="bar"></div><div class="body"><span class="tag soon">En préparation</span><h3>Likelemba</h3><p>La ristourne de groupe reliée au Mobile Money : chaque versement est validé avec son montant.</p><span class="go">En savoir plus →</span></div></a>
    <a class="app" href="#app-carnet" data-k="bientot" style="--c:var(--carnet)"><div class="pic"><span class="em">📒</span></div><div class="bar"></div><div class="body"><span class="tag soon">En préparation</span><h3>Mon carnet</h3><p>Un bloc-notes personnel, à votre image, pour garder vos idées, listes et rappels.</p><span class="go">En savoir plus →</span></div></a>
    <a class="app" href="#app-kiosque" data-k="bientot" style="--c:var(--kiosque)"><div class="pic"><span class="em">📦</span></div><div class="bar"></div><div class="body"><span class="tag soon">En préparation</span><h3>Inventaire kiosque</h3><p>L'inventaire de votre kiosque dans le téléphone, pour savoir ce que vous avez en stock.</p><span class="go">En savoir plus →</span></div></a>
   </div>

   <div class="head" style="margin-top:56px"><p class="eyebrow">Téléchargement sûr</p><h2>Prenez toujours la vraie application</h2></div>
   <div class="safe">
    <div><b>Une seule adresse officielle</b><p>Téléchargez uniquement depuis micheltshiepela331-gif.github.io. Regardez la barre d'adresse avant de toucher un bouton.</p></div>
    <div><b>Ce que nos applications ne font jamais</b><p>Elles ne demandent ni votre code Mobile Money, ni votre code PIN, ni vos contacts.</p></div>
    <div class="alert"><b>Attention aux faux</b><p>N'installez pas un APK reçu d'une autre personne. Les clés viennent uniquement du WhatsApp +243 974 829 341.</p></div>
   </div>
  </div>
 </section>
</div>

<!-- ===================== INTERFACE 3 : ANNONCES ===================== -->
<div class="view" id="v-annonces" data-view="annonces">
 <div class="vhero" style="--vg:linear-gradient(130deg,#B0207C,#E2187B 45%,#F7871A)">
  <div class="in"><p class="eyebrow">Annonces</p><h1>Nouveautés et projets</h1><p class="lead">Les dernières nouvelles de LushiPratique, nos projets en préparation et les affiches à partager.</p></div>
 </div>
 <section>
  <div class="in">
   <div class="head"><p class="eyebrow">Dernières nouvelles</p><h2>Quoi de neuf ?</h2></div>
   <div class="feed">
    <article class="post" style="--c:var(--kalamu)"><div class="pb"><div class="meta"><span class="tag new">Nouveau</span><span>27 octobre 2026</span></div><h3>Kalamu est en ligne : le traitement de texte des étudiants</h3><p>Plus besoin d'ordinateur pour taper un travail pratique. Kalamu reprend les onglets de Word sur le téléphone tenu à l'horizontale.</p><ul><li>Modèles prêts : travail pratique, TFC / mémoire, lettre, CV, rapport de stage</li><li>Page de garde, tableaux, images, numéros de page, table des matières automatique</li><li>Enregistrement en Word (.docx) et en PDF, ouverture des fichiers Word</li></ul><div class="ctas" style="margin-top:6px"><a class="btn c" href="#app-kalamu" style="--c:var(--kalamu)">Découvrir Kalamu</a></div></div></article>
    <article class="post" style="--c:var(--shop)"><div class="pb"><div class="meta"><span class="tag ok">Mise à jour</span><span>Octobre 2026</span></div><h3>Shop Rédemption passe en version 1.5</h3><p>Le détecteur de fuite devient plus précis.</p><ul><li><b>Où chercher la fuite</b> : case oubliée, zéro de trop, baisse inhabituelle, dollars introuvables</li><li><b>Carnet des fuites</b> : les habitudes apparaissent, par exemple « les fuites reviennent le mardi »</li><li>Chiffres bien séparés, code secret plus solide, aucune publicité</li></ul><div class="ctas" style="margin-top:6px"><a class="btn c" href="#app-shop" style="--c:var(--shop)">Voir Shop Rédemption</a></div></div></article>
    <article class="post" style="--c:var(--tresor)"><div class="pb"><div class="meta"><span class="tag free">Gratuit</span><span>Octobre 2026</span></div><h3>Trésor des dates : version Android disponible</h3><p>L'encyclopédie du temps biblique s'installe maintenant sur Android, et reste disponible en ligne pour tous les téléphones.</p><div class="ctas" style="margin-top:6px"><a class="btn c" href="#app-tresor" style="--c:var(--tresor)">Ouvrir Trésor des dates</a></div></div></article>
   </div>
  </div>
 </section>

 <section class="soft" id="prochainement">
  <div class="in">
   <div class="head"><p class="eyebrow">En préparation</p><h2>Bientôt chez LushiPratique</h2><p class="lead">Ces applications sont en cours de conception. Touchez-en une pour être prévenu de sa sortie.</p></div>
   <div class="soon">
    <button data-open="app-djambo" style="--c:var(--djambo)"><span class="em">💬</span><b>Djambo</b><small>Messagerie gratuite, économe en données</small></button>
    <button data-open="app-likelemba" style="--c:var(--likelemba)"><span class="em">🤝</span><b>Likelemba</b><small>Ristourne de groupe avec le Mobile Money</small></button>
    <button data-open="app-carnet" style="--c:var(--carnet)"><span class="em">📒</span><b>Mon carnet</b><small>Bloc-notes personnel</small></button>
    <button data-open="app-kiosque" style="--c:var(--kiosque)"><span class="em">📦</span><b>Inventaire kiosque</b><small>Le stock de votre kiosque</small></button>
   </div>
  </div>
 </section>

 <section id="affiches">
  <div class="in">
   <div class="head"><p class="eyebrow">Affiches</p><h2>Partagez nos applications</h2><p class="lead">Ces affiches circulent sur WhatsApp. Faites un appui long sur une image pour l'enregistrer et la partager.</p></div>
   <div class="posters">
    <figure><img data-id="shop-affiche.jpg" src="data:image/webp;base64," width="560" height="669" loading="lazy" alt="Affiche Shop Rédemption"><figcaption>Shop Rédemption — votre caisse dans votre téléphone</figcaption></figure>
    <figure><img data-id="tresor-affiche.jpg" src="data:image/webp;base64," width="520" height="874" loading="lazy" alt="Affiche Trésor des dates par Michel Tshiepela"><figcaption>Trésor des dates — par Michel Tshiepela</figcaption></figure>
    <figure><img data-id="tresor-photo.jpg" src="data:image/webp;base64," width="720" height="642" loading="lazy" alt="Trésor des dates près d'une Bible"><figcaption>Trésor des dates — la Bible sur une ligne du temps</figcaption></figure>
   </div>
  </div>
 </section>

 <section style="padding-top:0">
  <div class="in">
   <div class="pub">
    <div><h2>Une idée d'application ? Un message à faire passer ?</h2><p>Commerçants, écoles, églises, associations : parlez-nous de votre besoin. Nous étudions chaque idée qui peut servir la cité, et nous pouvons faire connaître votre activité dans cet espace d'annonces.</p></div>
    <div class="ctas"><a class="btn white" href="https://wa.me/243974829341?text=Bonjour%20LushiPratique%2C%20j%27ai%20une%20id%C3%A9e%20%2F%20une%20annonce%20%3A%20" target="_blank" rel="noopener noreferrer">Écrire sur WhatsApp</a></div>
   </div>
  </div>
 </section>
</div>

<!-- ===================== INTERFACE 4 : CONTACT ===================== -->
<div class="view" id="v-contact" data-view="contact">
 <div class="vhero" style="--vg:linear-gradient(130deg,#0B3478,#1F6FE5 55%,#F08A00)">
  <div class="in"><p class="eyebrow">Contact</p><h1>Parlons-en</h1><p class="lead">Une question, une clé d'abonnement, une idée ? Michel Tshiepela vous répond.</p></div>
 </div>
 <section>
  <div class="in">
   <div class="contact">
    <div><h2>Écrivez-nous</h2><p>Réponse sur WhatsApp ou par e-mail. Vous pouvez aussi passer nous voir à Lubumbashi, quartier Kasapa.</p><div class="ctas" style="margin-top:20px"><a class="btn orange" href="https://wa.me/243974829341?text=Bonjour%20LushiPratique%20!" target="_blank" rel="noopener noreferrer">Écrire sur WhatsApp</a></div></div>
    <div class="ct">
     <div><p><small>WhatsApp</small><span id="wa">+243 974 829 341</span></p><button type="button" data-copy="wa">Copier</button></div>
     <div><p><small>E-mail</small><span id="em">micheltshiepela331@gmail.com</span></p><button type="button" data-copy="em">Copier</button></div>
     <div><p><small>Adresse</small><span id="adr">Commune Annexe, Quartier Kasapa, n° 23, Lubumbashi</span></p><button type="button" data-copy="adr">Copier</button></div>
    </div>
