<script>
(function(){
 var VIEWS=["accueil","applications","annonces","contact"];
 var ALIAS={shop:"app-shop",telecharger:"app-shop/telecharger",tresor:"app-tresor",kalamu:"app-kalamu",avis:"app-shop/avis",questions:"contact/questions",confidentialite:"contact/confidentialite",objectif:"accueil/objectif",apropos:"accueil/apropos",affiches:"annonces/affiches",bientot:"annonces/prochainement"};
 var lastView=null, openSheet=null, cameFromSite=false;
 function $(s,r){return (r||document).querySelector(s)}
 function $$(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))}
 // images répétées : une seule copie dans la page
 $$("img[data-meme]").forEach(function(i){var o=$('img[data-id="'+i.getAttribute("data-meme")+'"]'); if(o)i.src=o.src;});
 function route(){
  var h=decodeURIComponent(location.hash.replace(/^#/,""))||"accueil";
  if(ALIAS[h])h=ALIAS[h];
  var parts=h.split("/"), main=parts[0], sub=parts[1]||null, sheet=null;
  if(main.indexOf("app-")===0&&document.getElementById(main)){sheet=main; main=lastView||"applications";}
  if(VIEWS.indexOf(main)<0)main="accueil";
  if(main!==lastView){
   $$(".view").forEach(function(v){v.classList.toggle("on",v.getAttribute("data-view")===main)});
   $$("[data-v]").forEach(function(a){a.classList.toggle("on",a.getAttribute("data-v")===main)});
   if(!sheet&&!sub)window.scrollTo(0,0);
   lastView=main;
   document.title=(main==="accueil"?"LushiPratique : applications mobiles à Lubumbashi":{applications:"Applications",annonces:"Annonces",contact:"Contact"}[main]+" · LushiPratique");
  }
  $$(".sheet").forEach(function(s){s.classList.toggle("on",s.id===sheet)});
  document.body.classList.toggle("locked",!!sheet);
  openSheet=sheet;
  if(sheet){var sh=document.getElementById(sheet); if(sub){var t=document.getElementById(sub); if(t&&sh.contains(t)){setTimeout(function(){sh.scrollTop=t.offsetTop-70},30)}} else sh.scrollTop=0;}
  else if(sub){var el=document.getElementById(sub); if(el)setTimeout(function(){el.scrollIntoView({block:"start"})},30)}
 }
 window.addEventListener("hashchange",function(){cameFromSite=true; route()});
 route();
 function closeSheet(){if(!openSheet)return; if(cameFromSite&&history.length>1)history.back(); else location.hash="#"+(lastView||"applications");}
 $$("[data-close]").forEach(function(b){b.addEventListener("click",closeSheet)});
 document.addEventListener("keydown",function(e){if(e.key==="Escape")closeSheet()});
 $$("[data-open]").forEach(function(b){b.addEventListener("click",function(){location.hash="#"+b.getAttribute("data-open")})});
 // filtres des applications
 $$(".chip").forEach(function(c){c.addEventListener("click",function(){var f=c.getAttribute("data-f"); $$(".chip").forEach(function(x){x.classList.toggle("on",x===c)}); $$(".apps .app").forEach(function(a){a.hidden=!(f==="all"||a.getAttribute("data-k")===f)})})});
 // copier les contacts
 function sel(el){try{var r=document.createRange(); r.selectNodeContents(el); var s=getSelection(); s.removeAllRanges(); s.addRange(r);}catch(e){}}
 $$("[data-copy]").forEach(function(b){b.addEventListener("click",function(){var el=document.getElementById(b.getAttribute("data-copy")), t=el.textContent; var done=function(x){b.textContent=x; setTimeout(function(){b.textContent="Copier"},2000)}; try{navigator.clipboard.writeText(t).then(function(){done("Copié ✓")},function(){sel(el); done("Sélectionné")})}catch(e){sel(el); done("Sélectionné")}})});
})();
</script>
